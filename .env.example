APP_NAME=GinPlate
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_PORT=8080
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ginplate
DB_USERNAME=root
DB_PASSWORD=
# DB_LOG_MODE=warn

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=
REDIS_DB=0

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_DOMAIN=null

CACHE_STORE=redis
# redis|database|memory. Unreachable redis degrades to memory with a warning.
# CACHE_PREFIX=ginplate_

FILESYSTEM_DISK=local
FILESYSTEM_ROOT=storage/app
# Public disk: files served at FILESYSTEM_PUBLIC_URL (defaults to APP_URL/storage).
FILESYSTEM_PUBLIC_ROOT=storage/app/public
# FILESYSTEM_PUBLIC_URL=https://cdn.example.com/storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
# log|smtp|ses. smtp uses HOST/PORT/USERNAME/PASSWORD/ENCRYPTION below;
# ses reuses AWS_ACCESS_KEY_ID/SECRET/REGION above (empty key = SDK default chain).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
# MAIL_TIMEOUT_SEC=10
MAIL_FROM_ADDRESS=hello@example.com
# ${VAR} references expand at load: keep your sender branded automatically.
MAIL_FROM_NAME="${APP_NAME} Team"

QUEUE_CONNECTION=sync
# Total runs per job including the first attempt (min 1) before burial.
# QUEUE_TRIES=3

# LOG_LEVEL=debug
# LOG_OUTPUT=

# HTTP hardening: empty CORS_ALLOWED_ORIGINS = allow all (dev only).
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_RPS=10
ENABLE_GZIP=true
HTTP_READ_TIMEOUT_SEC=15
HTTP_WRITE_TIMEOUT_SEC=15
HTTP_IDLE_TIMEOUT_SEC=60
SHUTDOWN_TIMEOUT_SEC=5
ENABLE_SWAGGER=true

# Maintenance marker location for `ginplate down` / `ginplate up`.
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_PATH=storage/framework/down
