APP_NAME=GinPlate
APP_ENV=local
# key:generate fills this
# APP_KEY is empty until generated: run `make keygen` (writes into .env).
# Keep any explanatory comment on its own line — never trailing the value.
APP_KEY=
APP_DEBUG=false
APP_PORT=8080
APP_URL=http://localhost:8080
APP_TTL_MIN=60

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ginplate
DB_USERNAME=ginplate
DB_PASSWORD=
DB_SSLMODE=disable
# Optional MySQL verification extras (used with verify-full/verify-ca):
# PEM bundle appended to the system CA pool, and TLS ServerName override.
# DB_SSLROOTCERT=/etc/ssl/certs/company-ca.pem
# DB_SSLSERVERNAME=db.internal.example.com
DB_LOG_MODE=warn

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

SESSION_DRIVER=redis

CACHE_STORE=redis
# CACHE_PREFIX=ginplate_

FILESYSTEM_DISK=local
FILESYSTEM_ROOT=storage/app
FILESYSTEM_PUBLIC_ROOT=storage/app/public
# FILESYSTEM_PUBLIC_URL=https://cdn.example.com/storage

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME} Team"

QUEUE_CONNECTION=sync
QUEUE_TRIES=3

LOG_LEVEL=info
LOG_OUTPUT=storage/logs

CORS_ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_RPS=10
ENABLE_GZIP=true
HTTP_READ_TIMEOUT_SEC=15
HTTP_WRITE_TIMEOUT_SEC=15
HTTP_IDLE_TIMEOUT_SEC=60
SHUTDOWN_TIMEOUT_SEC=5
# TLS_CERT_FILE=
# TLS_KEY_FILE=
ENABLE_SWAGGER=false

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_PATH=storage/framework/down

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false